{
    "name": "schachbulle/contao-fernschach-bundle",
    "type": "contao-bundle",
    "description": "Verwaltet den Fernschachbetrieb mit Meldeformularen für Einzel- und Mannschaftsturniere, Titeln, Titelnormen und Kontoauszügen.",
    "keywords": [
        "contao",
        "schach",
        "fernschach",
        "turnier",
        "bdf"
    ],
    "homepage": "https://github.com/Samson1964/contao-fernschach-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^5.6 || ^7 || ^8",
        "contao/core-bundle": "^4",
        "codefog/contao-haste": "<5",
        "schachbulle/contao-helper-bundle": "*",
        "menatwork/contao-multicolumnwizard-bundle": "*",
        "phpoffice/phpspreadsheet": "*"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "doctrine/doctrine-cache-bundle": "^1.3"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoFernschachBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoFernschachBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-fernschach-bundle/issues",
        "source": "https://github.com/Samson1964/contao-fernschach-bundle"
    }
}
